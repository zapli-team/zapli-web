# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Articles API ─────────────────────────────────────────────────────────────
# Bearer token used to authenticate POST /api/articles requests.
# Must match the value configured in the n8n workflow's Authorization header.
ARTICLES_API_TOKEN=your-secret-token-here

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── n8n Automation ───────────────────────────────────────────────────────────
# These are used by n8n/deploy-workflow.sh to deploy the Articles Generator
# workflow to your n8n instance. They are NOT needed at runtime by Next.js.
N8N_URL=https://n8n.your-domain.com
N8N_API_KEY=your-n8n-api-key
